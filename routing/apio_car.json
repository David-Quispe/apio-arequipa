// Modelo de costos de Proyecto APIO: ademas del filtro base de car_access,
// penaliza vias de menor jerarquia (residencial, calle vecinal, servicio) y
// premia vias con mas carriles. Esto refleja 2 de los 3 criterios
// automatizables de la rubrica de privilegios (ver privilegios_via en
// PostGIS): una ambulancia deberia preferir arterias con mas espacio/
// visibilidad para ejercer su privilegio de via, en vez de atajos por
// calles residenciales angostas aunque sean mas cortas en distancia.
{
  "distance_influence": 90,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "road_class == RESIDENTIAL", "multiply_by": "0.6" },
    { "if": "road_class == LIVING_STREET", "multiply_by": "0.3" },
    { "if": "road_class == SERVICE", "multiply_by": "0.3" },
    { "if": "road_class == TRACK", "multiply_by": "0.1" },
    { "if": "lanes >= 3", "multiply_by": "1.15" },
    { "else_if": "lanes == 1", "multiply_by": "0.85" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" }
  ]
}
