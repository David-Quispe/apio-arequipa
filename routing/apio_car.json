// Modelo de costos de Proyecto APIO. GENERADO por
// backend/scripts/generar_privilegios_graphhopper.py -- no editar a mano,
// volver a correr el script si cambia privilegios_via.
//
// Ademas del filtro base de car_access y las reglas de jerarquia/carriles
// (calles residenciales/de servicio penalizadas, mas carriles premiados,
// aplicadas a toda la red), las reglas 'in_<avenida>' del final le dan un
// plus de prioridad a las avenidas del corredor piloto proporcional a su
// score_con_campo de la rubrica de privilegios -- la ruta elegida ahora sí
// refleja donde es mas viable ejercer el privilegio de via legal, no solo
// la jerarquia vial generica.
{
  "distance_influence": 90,
  "priority": [
    {
      "if": "!car_access",
      "multiply_by": "0"
    },
    {
      "if": "road_class == RESIDENTIAL",
      "multiply_by": "0.6"
    },
    {
      "if": "road_class == LIVING_STREET",
      "multiply_by": "0.3"
    },
    {
      "if": "road_class == SERVICE",
      "multiply_by": "0.3"
    },
    {
      "if": "road_class == TRACK",
      "multiply_by": "0.1"
    },
    {
      "if": "lanes >= 3",
      "multiply_by": "1.15"
    },
    {
      "else_if": "lanes == 1",
      "multiply_by": "0.85"
    },
    {
      "if": "in_av_alcides_carrion_1",
      "multiply_by": "1.18"
    },
    {
      "if": "in_av_alcides_carrion_2",
      "multiply_by": "1.18"
    },
    {
      "if": "in_av_bolognesi_1",
      "multiply_by": "1.19"
    },
    {
      "if": "in_av_bolognesi_2",
      "multiply_by": "1.19"
    },
    {
      "if": "in_av_bolognesi_3",
      "multiply_by": "1.19"
    },
    {
      "if": "in_av_bolognesi_4",
      "multiply_by": "1.19"
    },
    {
      "if": "in_av_dolores",
      "multiply_by": "1.18"
    },
    {
      "if": "in_av_ejercito",
      "multiply_by": "1.24"
    },
    {
      "if": "in_av_goyeneche",
      "multiply_by": "1.24"
    },
    {
      "if": "in_el_filtro",
      "multiply_by": "1.18"
    },
    {
      "if": "in_peral",
      "multiply_by": "1.18"
    },
    {
      "if": "in_puente_grau",
      "multiply_by": "1.21"
    }
  ],
  "speed": [
